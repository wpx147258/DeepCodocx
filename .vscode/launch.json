{
    "version": "0.2.0",
    "configurations": [
        {
            // Interactive REPL: entry point is dcx/entry.py:main, reached
            // through the click command installed as the `dcx` script.
            "name": "dcx REPL",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "dcx",
            "args": [],
            "cwd": "${workspaceFolder}",
            // input() needs a real terminal, so the internal console will not work.
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            // Same entry point in one-shot mode; edit the prompt as needed.
            "name": "dcx print mode",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "module": "dcx",
            "args": ["run", "reply with the word pong"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        }
    ]
}
